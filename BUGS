def menu():
    print("\n--- GESTOR DE BUGS DE SISTEMA ---")
    print("1. Registrar nuevo error")
    print("2. Ver lista de errores")
    print("3. Salir")

def regi_bug(bugs):
    desc= input("Describe el error: ")
    priority= input("Indica la prioridad (Alta, Media, Baja): ")
    
    new = {
        "descripcion": desc,
        "prioridad": priority.lower
    }
    bugs.append(new)
    print("Error registrado.")

def ver_bugs(bugs):
    if len(bugs) == 0:
        print("No hay errores registrados todavía.")
    else:
        print("\n--- LISTA DE ERRORES ACTUALES ---")
        for i in range(len(bugs)):
            bug_actual = bugs[i]
            print(f"Bug {i+1}: {bug_actual['desc']} | Prioridad: {bug_actual['priority']}")

bugs = []

while True:
    menu()
    opcion = input("Elige una opción (1, 2 o 3): ")
    
    match opcion:
        case 1:
            regi_bug(bugs)
        case 2:
            ver_bugs(bugs)
        case 3:
            print("Saliendo del programa...")
            break
        case_:
           print("Opción inválida.")
